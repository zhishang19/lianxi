# 训练营 LangChain4j 环境变量
# 复制为 .env 后填入真实值, 切勿提交到 Git (已在 .gitignore)
#
# ===== LLM 后端二选一 =====
# 默认 ollama (本地, 集训机房推荐)
CAMP_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# 切到 OpenAI 兼容 API 时, 取消以下注释并填入 Key:
# CAMP_LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-3.5-turbo
# OPENAI_API_KEY=sk-your-real-key-here
